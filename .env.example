# OpenAI API Key (required for LLM and vision capabilities)
OPENAI_API_KEY=sk-your-api-key-here

# Voice settings
WAKE_WORD=jarvis
VOICE_RATE=175
VOICE_VOLUME=0.9
LANGUAGE=en

# LLM settings
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Automation settings
MOUSE_MOVE_DURATION=0.3
TYPING_INTERVAL=0.02
SCREENSHOT_QUALITY=85

# Conversation settings
MAX_CONVERSATION_HISTORY=20
CONVERSATION_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=jarvis.log
