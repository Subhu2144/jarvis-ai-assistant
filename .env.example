# Groq API Key (required for LLM capabilities)
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=gsk-your-api-key-here

# Voice settings
WAKE_WORD=jarvis
VOICE_RATE=175
VOICE_VOLUME=0.9
LANGUAGE=en

# LLM settings
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
LLM_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# Automation settings
MOUSE_MOVE_DURATION=0.3
TYPING_INTERVAL=0.02
SCREENSHOT_QUALITY=85

# Conversation settings
MAX_CONVERSATION_HISTORY=20
CONVERSATION_TIMEOUT=300

# Logging
LOG_LEVEL=INFO
LOG_FILE=jarvis.log
